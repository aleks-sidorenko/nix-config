{
  "provider": {
    "tailscale": {
      "oauth_client_id": "${var.tailscale_oauth_client_id}",
      "oauth_client_secret": "${var.tailscale_oauth_client_secret}",
      "tailnet": "colobus-bramble.ts.net"
    }
  },
  "resource": {
    "tailscale_acl": {
      "this": {
        "acl": "{\"acls\":[{\"action\":\"accept\",\"dst\":[\"tag:server:22\",\"tag:server:80\",\"tag:server:443\",\"tag:server:25565\"],\"src\":[\"tag:workstation\",\"autogroup:member\"]},{\"action\":\"accept\",\"dst\":[\"tag:workstation:*\"],\"src\":[\"tag:workstation\",\"autogroup:member\"]}],\"ssh\":[{\"action\":\"accept\",\"dst\":[\"tag:server\",\"tag:workstation\"],\"src\":[\"tag:workstation\",\"autogroup:member\"],\"users\":[\"autogroup:nonroot\",\"root\"]}],\"tagOwners\":{\"tag:registrar\":[\"autogroup:admin\"],\"tag:server\":[\"autogroup:admin\",\"tag:registrar\"],\"tag:workstation\":[\"autogroup:admin\",\"tag:registrar\"]}}"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "tailscale": {
        "source": "tailscale/tailscale",
        "version": "~> 0.17"
      }
    }
  },
  "variable": {
    "state_passphrase": {
      "sensitive": true,
      "type": "string"
    },
    "tailscale_oauth_client_id": {
      "type": "string"
    },
    "tailscale_oauth_client_secret": {
      "sensitive": true,
      "type": "string"
    }
  }
}
