# Renders .sops.yaml: who may decrypt each secrets file follows from the
# hosts' configs and the host keys under secrets/hosts, never a hand-kept list.
{ config, lib, ... }:
let
  secrets = ../../secrets;
  hostKey = name: secrets + "/hosts/${name}.pub";

  systemOf =
    name: config.flake.nixosConfigurations.${name} or config.flake.darwinConfigurations.${name} or null;

  # Hosts with an identity in the repo that decrypt anything at all.
  hosts = lib.filterAttrs (
    name: _:
    builtins.pathExists (hostKey name) && systemOf name != null && (systemOf name).config ? sops
  ) (lib.mergeAttrsList (lib.attrValues config.den.hosts));

  # Whoever administers a host can read its secrets, and every host key.
  owners = lib.unique (
    lib.concatMap (
      host:
      map (user: user.identity.gpgKeyFile) (
        lib.filter (user: user.userName == host.primaryUser) (lib.attrValues host.users)
      )
    ) (lib.attrValues hosts)
  );

  hostFiles = lib.attrNames (
    lib.filterAttrs (name: type: type == "regular" && lib.hasSuffix ".yaml" name) (
      builtins.readDir secrets
    )
  );

  # Both sides are paths in the flake's source, so equal strings mean the same file.
  readers =
    file:
    lib.attrNames (
      lib.filterAttrs (
        name: _: toString (secrets + "/${file}") == toString (systemOf name).config.sops.defaultSopsFile
      ) hosts
    );

  rule = path_regex: readers: {
    inherit path_regex;
    pgp = owners;
    hosts = readers;
  };

  rules = [
    (rule "secrets/hosts/[^/]+\\.yaml$" [ ])
  ]
  ++ lib.concatMap (
    file:
    lib.optional (readers file != [ ]) (
      rule "secrets/${lib.removeSuffix ".yaml" file}\\.ya?ml$" (readers file)
    )
  ) hostFiles
  ++ [ (rule "infra/secrets\\.ya?ml$" [ ]) ]
  ++ map (stack: rule "infra/${stack}/secrets\\.ya?ml$" [ ]) (lib.attrNames config.den.stacks);
in
{
  perSystem =
    { pkgs, ... }:
    let
      hostNames = lib.unique (lib.concatMap (r: r.hosts) rules);
      # The recipient is the encryption subkey, named by its fingerprint.
      encryptionKey =
        pkgs.runCommand "pgp-encryption-keys.json"
          {
            nativeBuildInputs = [
              pkgs.gnupg
              pkgs.jq
            ];
          }
          ''
            export GNUPGHOME=$(mktemp -d)
            keys='{}'
            ${lib.concatMapStrings (file: ''
              fpr=$(gpg --show-keys --with-colons ${file} | awk -F: '$1 == "sub" && $12 ~ /e/ { enc = 1; next } enc && $1 == "fpr" { print $10; exit }')
              keys=$(jq --arg f ${file} --arg k "$fpr" '.[$f] = $k' <<<"$keys")
            '') owners}
            echo "$keys" > $out
          '';
      rendered =
        pkgs.runCommand "sops.yaml"
          {
            nativeBuildInputs = [
              pkgs.jq
              pkgs.ssh-to-age
              pkgs.yq-go
            ];
            rules = builtins.toJSON rules;
            passAsFile = [ "rules" ];
          }
          ''
            ages='{}'
            ${lib.concatMapStrings (name: ''
              ages=$(jq --arg n ${name} --arg a "$(ssh-to-age -i ${hostKey name})" '.[$n] = $a' <<<"$ages")
            '') hostNames}
            jq --argjson ages "$ages" --slurpfile pgp ${encryptionKey} '{
              creation_rules: map({
                path_regex,
                key_groups: [{ pgp: [.pgp[] | $pgp[0][.]] } + (if .hosts == [] then {} else { age: [.hosts[] | $ages[.]] } end)]
              })
            }' "$rulesPath" > rules.json
            {
              echo '# Generated by `just sops-write` from modules/flake/sops.nix; do not edit.'
              yq -P -p json -o yaml rules.json
            } > $out
          '';
    in
    {
      packages.write-sops = pkgs.writeShellApplication {
        name = "write-sops";
        runtimeInputs = [ pkgs.git ];
        text = ''
          install -m 644 ${rendered} "$(git rev-parse --show-toplevel)/.sops.yaml"
        '';
      };

      checks.sops-config = pkgs.runCommand "sops-config" { } ''
        diff -u ${../../.sops.yaml} ${rendered} || {
          echo ".sops.yaml is stale; run: just sops-write" >&2
          exit 1
        }
        touch $out
      '';
    };

  evalTests.sops-rules =
    let
      owner = ../../identities/alexander/gpg.pub.asc;
      ownerOnly = path_regex: {
        inherit path_regex;
        pgp = [ owner ];
        hosts = [ ];
      };
    in
    {
      expr = rules;
      expected = [
        (ownerOnly "secrets/hosts/[^/]+\\.yaml$")
        {
          path_regex = "secrets/darwin\\.ya?ml$";
          pgp = [ owner ];
          hosts = [ "workbook" ];
        }
        {
          path_regex = "secrets/nixos\\.ya?ml$";
          pgp = [ owner ];
          hosts = [ "server" ];
        }
        (ownerOnly "infra/secrets\\.ya?ml$")
        (ownerOnly "infra/dns/secrets\\.ya?ml$")
        (ownerOnly "infra/repos/secrets\\.ya?ml$")
        (ownerOnly "infra/router/secrets\\.ya?ml$")
        (ownerOnly "infra/storage/secrets\\.ya?ml$")
        (ownerOnly "infra/tailnet/secrets\\.ya?ml$")
      ];
    };
}
