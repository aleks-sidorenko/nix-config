# Renders .sops.yaml: who may decrypt each secrets file follows from the
# hosts' configs and their SSH keys (`sshKeyFile`), never a hand-kept list.
{ config, lib, ... }:
let
  secrets = ../../secrets;

  systemOf =
    name: config.flake.nixosConfigurations.${name} or config.flake.darwinConfigurations.${name} or null;

  allHosts = lib.mergeAttrsList (lib.attrValues config.den.hosts);

  # Whoever administers a host can read its secrets, and every host key.
  owners = lib.unique (
    lib.concatMap (
      host:
      map (user: user.identity.gpgKeyFile) (
        lib.filter (user: user.userName == host.primaryUser) (lib.attrValues host.users)
      )
    ) (lib.attrValues allHosts)
  );

  hostFiles = lib.attrNames (
    lib.filterAttrs (name: type: type == "regular" && lib.hasSuffix ".yaml" name) (
      builtins.readDir secrets
    )
  );

  rule = path_regex: readers: {
    inherit path_regex;
    pgp = owners;
    hosts = readers;
  };

  # Every file a host decrypts, as strings of paths in the flake's source.
  filesOf =
    c:
    lib.unique (
      map toString (
        [ c.sops.defaultSopsFile ] ++ map (secret: secret.sopsFile) (lib.attrValues c.sops.secrets)
      )
    );

  # The rules, given which hosts have an identity in the repo.
  rulesFor =
    hasKey:
    let
      # Hosts that decrypt anything at all.
      keyed = lib.filterAttrs (
        name: _: hasKey name && systemOf name != null && (systemOf name).config ? sops
      ) allHosts;
      readers =
        file:
        lib.attrNames (
          lib.filterAttrs (
            name: _: lib.elem (toString (secrets + "/${file}")) (filesOf (systemOf name).config)
          ) keyed
        );
    in
    [
      (rule "hosts/[^/]+/ssh\\.yaml$" [ ])
    ]
    ++ lib.concatMap (
      file:
      lib.optional (readers file != [ ]) (
        rule "secrets/${lib.removeSuffix ".yaml" file}\\.ya?ml$" (readers file)
      )
    ) hostFiles
    ++ [ (rule "infra/secrets\\.ya?ml$" [ ]) ]
    ++ map (stack: rule "infra/${stack}/secrets\\.ya?ml$" [ ]) (lib.attrNames config.den.stacks);

  rules =
    assert lib.assertMsg (owners != [ ]) "no host has a primary user with a PGP key to own the secrets";
    rulesFor (name: allHosts.${name}.sshKeyFile != null);
in
{
  perSystem =
    { pkgs, ... }:
    let
      hostNames = lib.unique (lib.concatMap (r: r.hosts) rules);
      # Reads `gpg --with-colons`; prints the fingerprint of the encryption subkey.
      encryptionSubkey = pkgs.writeText "encryption-subkey.awk" ''
        $1 == "sub" { enc = $12 ~ /e/ && $2 !~ /[erd]/; next }
        enc && $1 == "fpr" { last = $10; enc = 0 }
        END { if (last == "") exit 1; print last }
      '';
      # The recipient is the encryption subkey, named by its fingerprint.
      encryptionKey =
        pkgs.runCommand "pgp-encryption-keys.json"
          {
            nativeBuildInputs = [
              pkgs.gnupg
              pkgs.jq
            ];
          }
          ''
            export GNUPGHOME=$(mktemp -d)
            keys='{}'
            ${lib.concatMapStrings (file: ''
              fpr=$(gpg --show-keys --with-colons ${file} | awk -F: -f ${encryptionSubkey})
              keys=$(jq --arg f ${file} --arg k "$fpr" '.[$f] = $k' <<<"$keys")
            '') owners}
            echo "$keys" > $out
          '';
      rendered =
        pkgs.runCommand "sops.yaml"
          {
            nativeBuildInputs = [
              pkgs.jq
              pkgs.ssh-to-age
              pkgs.yq-go
            ];
            rules = builtins.toJSON rules;
            passAsFile = [ "rules" ];
          }
          ''
            ages='{}'
            ${lib.concatMapStrings (name: ''
              ages=$(jq --arg n ${name} --arg a "$(ssh-to-age -i ${allHosts.${name}.sshKeyFile})" '.[$n] = $a' <<<"$ages")
            '') hostNames}
            jq --argjson ages "$ages" --slurpfile pgp ${encryptionKey} '{
              creation_rules: map({
                path_regex,
                key_groups: [{ pgp: [.pgp[] | $pgp[0][.]] } + (if .hosts == [] then {} else { age: [.hosts[] | $ages[.]] } end)]
              })
            }' "$rulesPath" > rules.json
            {
              echo '# Generated by `just sops-write` from modules/flake/sops.nix; do not edit.'
              yq -P -p json -o yaml rules.json
            } > $out
          '';
    in
    {
      packages.write-sops = pkgs.writeShellApplication {
        name = "write-sops";
        runtimeInputs = [ pkgs.git ];
        text = ''
          install -m 644 ${rendered} "$(git rev-parse --show-toplevel)/.sops.yaml"
        '';
      };

      # A rotated key keeps its expired or revoked subkeys; only a usable one is
      # a recipient, and none at all fails the build.
      checks.sops-encryption-subkey = pkgs.runCommand "sops-encryption-subkey" { } ''
        pick() { printf '%s\n' "$@" | awk -F: -f ${encryptionSubkey}; }
        signing='sub:-:255:22:S:1:2:::::s:'
        expired='sub:e:255:18:E:1:2:::::e:'
        revoked='sub:r:255:18:R:1:2:::::e:'
        valid='sub:-:255:18:V:1:2:::::e:'
        fpr() { echo "fpr:::::::::$1:"; }
        [ "$(pick "$signing" "$(fpr S)" "$valid" "$(fpr V)")" = V ]
        [ "$(pick "$expired" "$(fpr E)" "$valid" "$(fpr V)")" = V ]
        [ "$(pick "$valid" "$(fpr V)" "$revoked" "$(fpr R)")" = V ]
        ! pick "$expired" "$(fpr E)" "$revoked" "$(fpr R)"
        touch $out
      '';

      checks.sops-config = pkgs.runCommand "sops-config" { } ''
        diff -u ${../../.sops.yaml} ${rendered} || {
          echo ".sops.yaml is stale; run: just sops-write" >&2
          exit 1
        }
        touch $out
      '';
    };

  evalTests = {
    sops-files-of-a-host = {
      expr = filesOf {
        sops = {
          defaultSopsFile = /a.yaml;
          secrets = {
            x.sopsFile = /a.yaml;
            y.sopsFile = /b.yaml;
          };
        };
      };
      expected = [
        "/a.yaml"
        "/b.yaml"
      ];
    };

    # A repo with no host keys yet, or after retiring the last host, still
    # has an owner for every file it can create.
    sops-rules-without-host-keys = {
      expr = rulesFor (_: false);
      expected =
        map
          (path_regex: {
            inherit path_regex;
            pgp = [ ../../identities/alexander/gpg.pub.asc ];
            hosts = [ ];
          })
          (
            [
              "hosts/[^/]+/ssh\\.yaml$"
              "infra/secrets\\.ya?ml$"
            ]
            ++ map (stack: "infra/${stack}/secrets\\.ya?ml$") [
              "dns"
              "repos"
              "router"
              "storage"
              "tailnet"
            ]
          );
    };

    sops-rules =
      let
        owner = ../../identities/alexander/gpg.pub.asc;
        ownerOnly = path_regex: {
          inherit path_regex;
          pgp = [ owner ];
          hosts = [ ];
        };
      in
      {
        expr = rules;
        expected = [
          (ownerOnly "hosts/[^/]+/ssh\\.yaml$")
          {
            path_regex = "secrets/darwin\\.ya?ml$";
            pgp = [ owner ];
            hosts = [ "workbook" ];
          }
          {
            path_regex = "secrets/nixos\\.ya?ml$";
            pgp = [ owner ];
            hosts = [ "server" ];
          }
          (ownerOnly "infra/secrets\\.ya?ml$")
          (ownerOnly "infra/dns/secrets\\.ya?ml$")
          (ownerOnly "infra/repos/secrets\\.ya?ml$")
          (ownerOnly "infra/router/secrets\\.ya?ml$")
          (ownerOnly "infra/storage/secrets\\.ya?ml$")
          (ownerOnly "infra/tailnet/secrets\\.ya?ml$")
        ];
      };
  };
}
