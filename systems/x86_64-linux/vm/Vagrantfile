Vagrant.configure("2") do |config|
  # Name the machine "vm" so `vagrant ssh-config` emits `Host vm` directly
  # (matches the flake attr .#vm — no `--host` override needed).
  config.vm.define "vm"

  # Connect as "vagrant" (the box default) — declared explicitly so ssh-config
  # and `just bootstrap vm vagrant` agree on the login user.
  config.ssh.username = "vagrant"

  config.vm.box = "generic/ubuntu2204"  # Base OS (will be replaced with NixOS)

  # Increase timeout and retries
  config.vm.boot_timeout = 6000
  config.ssh.connect_timeout = 600

  # Use virtualbox provider
  config.vm.provider :virtualbox do |vb|
    vb.memory = 8096
    vb.cpus = 4
    # Enable nested virtualization
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
  end

  # Create a public network (bridged to your local network)
  config.vm.network :public_network

  config.vm.provision "shell", inline: <<-SHELL
    # Set up the DNS
    sudo rm /etc/resolv.conf
    sudo bash -c 'echo "nameserver 8.8.8.8" > /etc/resolv.conf'
    sudo chattr +i /etc/resolv.conf  # Lock file (Debian/Ubuntu)

    # Configure passwordless sudo
    echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/vagrant
    chmod 440 /etc/sudoers.d/vagrant

    # NOTE: SSH access is left to Vagrant's own inserted keypair — do not
    # overwrite authorized_keys here, or `vagrant ssh` / key-based bootstrap
    # break and only password auth survives.

  SHELL
end
