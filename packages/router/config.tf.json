        "internal_path_cost": 10,
        "path_cost": 10
      },
      "ether9": {
        "bridge": "bridge",
        "comment": "defconf",
        "ingress_filtering": false,
        "interface": "ether9",
        "internal_path_cost": 10,
        "path_cost": 10
      },
      "sfp1": {
        "bridge": "bridge",
        "comment": "defconf",
        "ingress_filtering": false,
        "interface": "sfp1",
        "internal_path_cost": 10,
        "path_cost": 10
      }
    },
    "routeros_interface_ethernet": {
      "ether1": {
        "comment": "WAN1",
        "factory_name": "ether1",
        "name": "ether1"
      }
    },
    "routeros_interface_list": {
      "LAN": {
        "comment": "defconf",
        "name": "LAN"
      },
      "WAN": {
        "comment": "defconf",
        "name": "WAN"
      }
    },
    "routeros_interface_list_member": {
      "bridge_LAN": {
        "comment": "defconf",
        "interface": "bridge",
        "list": "LAN"
      },
      "ether1_WAN": {
        "comment": "defconf",
        "interface": "ether1",
        "list": "WAN"
      },
      "lte1_WAN": {
        "interface": "lte1",
        "list": "WAN"
      }
    },
    "routeros_interface_lte_apn": {
      "default": {
