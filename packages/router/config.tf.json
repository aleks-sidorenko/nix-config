    "routeros_ip_dhcp_server_network": {
      "defconf": {
        "address": "10.0.0.0/24",
        "comment": "defconf",
        "dns_server": [
          "10.0.0.1"
        ],
        "gateway": "10.0.0.1",
        "netmask": "24"
      }
    },
    "routeros_ip_dns_record": {
      "ajax": {
        "address": "10.0.0.31",
        "name": "ajax.local",
        "type": "A"
      },
      "alias_gateway": {
        "address": "10.0.0.1",
        "name": "gateway.local",
        "type": "A"
      },
      "alias_home_assistant": {
        "address": "10.0.0.40",
        "name": "home-assistant.local",
        "type": "A"
      },
      "alias_jellyfin": {
        "address": "10.0.0.40",
        "name": "jellyfin.local",
        "type": "A"
      },
      "alias_minecraft": {
        "address": "10.0.0.40",
        "name": "minecraft.local",
        "type": "A"
      },
      "alias_minidlna": {
        "address": "10.0.0.40",
        "name": "minidlna.local",
        "type": "A"
      },
      "alias_prowlarr": {
        "address": "10.0.0.40",
        "name": "prowlarr.local",
        "type": "A"
      },
      "alias_qbittorrent": {
        "address": "10.0.0.40",
        "name": "qbittorrent.local",
        "type": "A"
      },
      "alias_radarr": {
        "address": "10.0.0.40",
