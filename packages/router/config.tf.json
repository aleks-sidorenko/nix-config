{
  "provider": {
    "routeros": {
      "hosturl": "api://10.0.0.1",
      "password": "${var.routeros_password}",
      "username": "${var.routeros_username}"
    }
  },
  "resource": {
    "routeros_capsman_channel": {
      "channel_2G": {
        "band": "2ghz-b/g/n",
        "control_channel_width": "20mhz",
        "name": "2G"
      },
      "channel_5G": {
        "band": "5ghz-a/n/ac",
        "control_channel_width": "20mhz",
        "name": "5G"
      }
    },
    "routeros_capsman_configuration": {
      "config_2G": {
        "channel": {
          "config": "2G"
        },
        "country": "ukraine",
        "datapath": {
          "config": "datapath"
        },
        "installation": "any",
        "mode": "ap",
        "name": "2G",
        "rx_chains": [
          0,
          1,
          2,
          3
        ],
        "security": {
          "config": "security"
        },
        "ssid": "SWEET-HOME",
        "tx_chains": [
          0,
          1,
          2,
          3
        ]
      },
      "config_5G": {
        "channel": {
          "config": "5G"
        },
        "country": "ukraine",
        "datapath": {
          "config": "datapath"
        },
        "installation": "any",
        "mode": "ap",
        "name": "5G",
        "rx_chains": [
          0,
          1,
          2,
          3
        ],
        "security": {
          "config": "security"
        },
        "ssid": "SWEET-HOME",
        "tx_chains": [
          0,
          1,
          2,
          3
        ]
      }
    },
    "routeros_capsman_datapath": {
      "datapath": {
        "bridge": "bridge",
        "client_to_client_forwarding": true,
        "local_forwarding": true,
        "name": "datapath"
      }
    },
    "routeros_capsman_manager": {
      "manager": {
        "enabled": true,
        "upgrade_policy": "require-same-version"
      }
    },
    "routeros_capsman_manager_interface": {
      "bridge": {
        "disabled": false,
        "interface": "bridge"
      }
    },
    "routeros_capsman_provisioning": {
      "prov_2G": {
        "action": "create-dynamic-enabled",
        "hw_supported_modes": [
          "gn"
        ],
        "master_configuration": "2G",
        "name_format": "prefix-identity",
        "name_prefix": "2G"
      },
      "prov_5G": {
        "action": "create-dynamic-enabled",
        "hw_supported_modes": [
          "ac"
        ],
        "master_configuration": "5G",
        "name_format": "prefix-identity",
        "name_prefix": "5G"
      }
    },
    "routeros_capsman_security": {
      "security": {
        "authentication_types": [
          "wpa-psk",
          "wpa2-psk"
        ],
        "encryption": [
          "aes-ccm"
        ],
        "name": "security",
        "passphrase": "${var.wifi_password}"
      }
    },
    "routeros_dns": {
      "settings": {
        "allow_remote_requests": true,
        "servers": [
          "8.8.8.8",
          "4.4.4.4"
        ]
      }
    },
    "routeros_interface_bridge": {
      "bridge": {
        "admin_mac": "08:55:31:E9:21:73",
        "auto_mac": false,
        "comment": "defconf",
        "name": "bridge",
        "port_cost_mode": "short"
      }
    },
    "routeros_interface_bridge_port": {
      "ether10": {
        "bridge": "bridge",
        "comment": "defconf",
        "ingress_filtering": false,
        "interface": "ether10",
        "internal_path_cost": 10,
        "path_cost": 10
      },
      "ether2": {
        "bridge": "bridge",
