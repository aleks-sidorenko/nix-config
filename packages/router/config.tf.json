    "routeros_ip_firewall_addr_list": {
      "tv_0": {
        "address": "10.0.0.50",
        "list": "tv"
      },
      "tv_1": {
        "address": "10.0.0.51",
        "list": "tv"
      }
    },
    "routeros_ip_firewall_connection_tracking": {
      "default": {
        "udp_timeout": "10s"
      }
    },
    "routeros_ip_firewall_filter": {
      "forward_accept_established": {
        "action": "accept",
        "chain": "forward",
        "comment": "defconf: accept established,related, untracked",
        "connection_state": "established,related,untracked",
        "place_before": "${routeros_ip_firewall_filter.forward_drop_invalid.id}"
      },
      "forward_accept_ipsec_in": {
        "action": "accept",
        "chain": "forward",
        "comment": "defconf: accept in ipsec policy",
        "ipsec_policy": "in,ipsec",
        "place_before": "${routeros_ip_firewall_filter.forward_accept_ipsec_out.id}"
      },
      "forward_accept_ipsec_out": {
        "action": "accept",
        "chain": "forward",
        "comment": "defconf: accept out ipsec policy",
        "ipsec_policy": "out,ipsec",
        "place_before": "${routeros_ip_firewall_filter.forward_fasttrack.id}"
      },
      "forward_drop_invalid": {
        "action": "drop",
        "chain": "forward",
        "comment": "defconf: drop invalid",
        "connection_state": "invalid",
        "place_before": "${routeros_ip_firewall_filter.forward_drop_wan_not_dstnat.id}"
      },
      "forward_drop_tv_external": {
        "action": "drop",
        "chain": "forward",
        "comment": "drop TV external traffic",
        "out_interface_list": "WAN",
        "src_address_list": "tv"
      },
      "forward_drop_wan_not_dstnat": {
        "action": "drop",
        "chain": "forward",
        "comment": "defconf: drop all from WAN not DSTNATed",
        "connection_nat_state": "!dstnat",
        "connection_state": "new",
        "in_interface_list": "WAN",
        "place_before": "${routeros_ip_firewall_filter.input_drop_dns_tcp.id}"
      },
      "forward_fasttrack": {
        "action": "fasttrack-connection",
        "chain": "forward",
        "comment": "defconf: fasttrack",
        "connection_state": "established,related",
        "place_before": "${routeros_ip_firewall_filter.forward_accept_established.id}"
      },
      "input_accept_established": {
        "action": "accept",
        "chain": "input",
        "comment": "defconf: accept established,related,untracked",
        "connection_state": "established,related,untracked",
        "place_before": "${routeros_ip_firewall_filter.input_drop_invalid.id}"
      },
      "input_accept_icmp": {
        "action": "accept",
        "chain": "input",
        "comment": "defconf: accept ICMP",
        "place_before": "${routeros_ip_firewall_filter.input_accept_loopback.id}",
        "protocol": "icmp"
      },
      "input_accept_loopback": {
        "action": "accept",
        "chain": "input",
        "comment": "defconf: accept to local loopback (for CAPsMAN)",
        "dst_address": "127.0.0.1",
        "place_before": "${routeros_ip_firewall_filter.input_drop_non_lan.id}"
      },
      "input_drop_dns_tcp": {
        "action": "drop",
        "chain": "input",
        "dst_port": 53,
        "in_interface_list": "WAN",
        "place_before": "${routeros_ip_firewall_filter.input_drop_dns_udp.id}",
        "protocol": "tcp"
      },
      "input_drop_dns_udp": {
        "action": "drop",
        "chain": "input",
        "dst_port": 53,
        "in_interface_list": "WAN",
        "place_before": "${routeros_ip_firewall_filter.forward_drop_tv_external.id}",
        "protocol": "udp"
      },
      "input_drop_invalid": {
        "action": "drop",
        "chain": "input",
        "comment": "defconf: drop invalid",
        "connection_state": "invalid",
        "place_before": "${routeros_ip_firewall_filter.input_accept_icmp.id}"
      },
      "input_drop_non_lan": {
        "action": "drop",
        "chain": "input",
        "comment": "defconf: drop all not coming from LAN",
        "in_interface_list": "!LAN",
        "place_before": "${routeros_ip_firewall_filter.forward_accept_ipsec_in.id}"
      }
    },
    "routeros_ip_firewall_nat": {
      "dns_redirect": {
        "action": "redirect",
        "chain": "dstnat",
        "dst_port": 53,
        "protocol": "udp",
        "to_addresses": "10.0.0.1",
        "to_ports": 53
      },
      "masquerade": {
        "action": "masquerade",
        "chain": "srcnat",
        "comment": "defconf: masquerade",
        "ipsec_policy": "out,none",
        "out_interface_list": "WAN"
      }
    },
    "routeros_ip_ipsec_profile": {
      "default": {
        "dpd_interval": "2m",
        "dpd_maximum_failures": 5,
        "name": "default"
      }
    },
    "routeros_ip_neighbor_discovery_settings": {
      "default": {
        "discover_interface_list": "LAN"
      }
    },
    "routeros_ip_pool": {
      "dhcp": {
        "name": "dhcp",
        "ranges": [
          "10.0.0.50-10.0.0.250"
        ]
      }
    },
    "routeros_ip_service": {
      "api": {
        "address": "10.0.0.0/24",
        "disabled": false,
        "numbers": "api",
        "port": 8728
      },
      "api_ssl": {
        "disabled": true,
        "numbers": "api-ssl",
        "port": 8729
      },
      "ftp": {
        "disabled": true,
        "numbers": "ftp",
        "port": 21
      },
      "ssh": {
        "address": "10.0.0.0/24",
        "numbers": "ssh",
        "port": 22
      },
      "telnet": {
        "disabled": true,
        "numbers": "telnet",
        "port": 23
      },
      "winbox": {
        "address": "10.0.0.0/24",
        "numbers": "winbox",
        "port": 8291
      },
      "www": {
        "disabled": true,
        "numbers": "www",
        "port": 80
      }
    },
    "routeros_ip_settings": {
      "default": {
        "max_neighbor_entries": 8192
      }
    },
    "routeros_ipv6_settings": {
      "default": {
        "accept_router_advertisements": "yes",
        "disable_ipv6": true,
        "max_neighbor_entries": 8192
      }
    },
    "routeros_routing_bfd_configuration": {
      "default": {
        "disabled": false
      }
    },
    "routeros_system_clock": {
      "default": {
        "time_zone_autodetect": false,
        "time_zone_name": "Europe/Kyiv"
      }
    },
    "routeros_system_identity": {
      "router": {
        "name": "Router"
      }
    },
    "routeros_tool_mac_server": {
      "default": {
        "allowed_interface_list": "LAN"
      }
    },
    "routeros_tool_mac_server_winbox": {
      "default": {
        "allowed_interface_list": "LAN"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "routeros": {
        "source": "terraform-routeros/routeros",
        "version": "~> 1.99"
      }
    }
  },
  "variable": {
    "routeros_password": {
      "description": "RouterOS API password",
      "sensitive": true,
      "type": "string"
    },
    "routeros_username": {
      "default": "alexander",
      "description": "RouterOS API username",
      "type": "string"
    },
    "state_passphrase": {
      "description": "Passphrase for OpenTofu state encryption (min 16 chars)",
      "sensitive": true,
      "type": "string"
    },
    "wifi_password": {
      "description": "WiFi password for CAPsMAN security",
      "sensitive": true,
      "type": "string"
    }
  }
}
