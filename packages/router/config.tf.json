        "type": "A"
      },
      "alias_restic": {
        "address": "10.0.0.40",
        "name": "restic.local",
        "type": "A"
      },
      "alias_sonarr": {
        "address": "10.0.0.40",
        "name": "sonarr.local",
        "type": "A"
      },
      "alias_zigbee2mqtt": {
        "address": "10.0.0.40",
        "name": "zigbee2mqtt.local",
        "type": "A"
      },
      "cap1": {
        "address": "10.0.0.11",
        "name": "cap1.local",
        "type": "A"
      },
      "cap2": {
        "address": "10.0.0.12",
        "name": "cap2.local",
        "type": "A"
      },
      "heatpump": {
        "address": "10.0.0.53",
        "name": "heatpump.local",
        "type": "A"
      },
      "inverter": {
        "address": "10.0.0.52",
        "name": "inverter.local",
        "type": "A"
      },
      "local_fwd": {
        "forward_to": "10.0.0.1",
        "regexp": ".*\\\\.local$$",
        "type": "FWD"
      },
      "monitor": {
        "address": "10.0.0.30",
        "name": "monitor.local",
        "type": "A"
      },
      "router": {
        "address": "10.0.0.1",
